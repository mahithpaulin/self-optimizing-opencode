{
  "schema": 1,
  "mode": "default-deny",
  "workspace_only": true,
  "allow": [
    "fs.read.workspace",
    "fs.write.workspace",
    "exec.python.unittest",
    "exec.python.compile",
    "exec.git.local.inspect",
    "exec.git.local.commit",
    "exec.readonly.utilities",
    "benchmark.run",
    "checkpoint.create",
    "model.propose.one_shot"
  ],
  "deny": [
    "fs.read.outside_workspace",
    "fs.write.outside_workspace",
    "fs.read.secrets",
    "fs.write.protected",
    "exec.shell",
    "exec.arbitrary",
    "exec.git.push",
    "exec.git.fetch",
    "exec.git.remote",
    "network.worker",
    "network.deploy",
    "email.send",
    "publish.content",
    "purchase",
    "account.create",
    "background.service",
    "selfmod.security_boundary",
    "selfmod.tests",
    "selfmod.benchmark_data"
  ],
  "protected_write_prefixes": [
    "config/permissions.json",
    "config/limits.json",
    "tools/security.py",
    "tools/search_baseline.py",
    "tools/bench.py",
    "tools/experiment.py",
    "tools/runner.py",
    "tools/state.py",
    "tools/checkpoint.py",
    "tools/model.py",
    "tools/inspect.py",
    "tools/baseline.py",
    "tools/freeze.py",
    "benchmarks/heldout.json",
    "benchmarks/tasks_dev.json",
    "benchmarks/tasks_heldout.json",
    "benchmarks/expected.json",
    "benchmarks/corpus/",
    "benchmarks/results/baseline.json",
    "tests/",
    ".git/",
    "tools/modelrun",
    "tools/oc2run",
    "model-host/",
    "rollback/",
    "checkpoints/",
    "REPORT.md"
  ],
  "secret_name_fragments": [
    "auth.json",
    ".env",
    "access_token",
    "id_rsa",
    "id_ed25519",
    "credentials",
    ".github_token"
  ],
  "worker_environment": {
    "inherit": [
      "PATH",
      "LANG"
    ],
    "set": {
      "OPENCODE_DISABLE_FREE_MODELS": "unset",
      "HTTP_PROXY": "http://127.0.0.1:9",
      "HTTPS_PROXY": "http://127.0.0.1:9",
      "ALL_PROXY": "http://127.0.0.1:9",
      "NO_PROXY": "",
      "PIP_NO_INDEX": "1",
      "GIT_TERMINAL_PROMPT": "0",
      "GIT_ALLOW_PROTOCOL": "file",
      "GIT_ASKPASS": "/bin/false",
      "SSH_ASKPASS": "/bin/false"
    },
    "drop": [
      "OPENCODE_API_KEY",
      "OPENCODE_PASSWORD",
      "KAGGLE_API_V1_TOKEN",
      "GH_TOKEN",
      "GITHUB_TOKEN"
    ]
  },
  "enforcement_note": "Default-deny is enforced in tools/security.py for all worker actions. The model runs separately behind an agent with every permission denied. No kernel namespace is available on this Android device; see README limitations."
}
